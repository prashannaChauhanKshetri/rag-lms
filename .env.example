# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_lms
POSTGRES_USER=rag_lms_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://rag_lms_user:change-me@localhost:5432/rag_lms

# ── Auth (generate with: openssl rand -hex 32) ───────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-string

# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Optional: share rate-limit counters across workers (falls back to in-memory)
# RATE_LIMIT_STORAGE=redis://localhost:6379/1

# ── CORS (comma-separated) ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ── Email (optional — password reset, invites) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:3000
APP_FROM_NAME=Gyanalms
